# Local development only. Set a unique password in the ignored .env before Compose.
POSTGRES_USER=eaap_dev
POSTGRES_DB=eaap_dev
# Java connects over the private Compose network; PostgreSQL is not published to the host.
DB_HOST=postgres
DB_PORT=5432
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
DB_PASSWORD=
IDENTITY_OPERATOR_DB_PASSWORD=
APP_ENV=development

# Public browser-facing build settings, never credentials. Connectivity is not implemented.
VITE_CONTROL_PLANE_API_URL=http://127.0.0.1:8080
VITE_AGENT_RUNTIME_API_URL=http://127.0.0.1:8000

# Optional compose.knowledge.yaml: generate a private random shared secret; no default.
EMBEDDING_SECRET=
# Absolute prepared model directory outside the repository.
EMBEDDING_MODEL_DIR=

# Optional hosted execution; use compose.execution.yaml with auth + knowledge overlays.
# Generate a separate 32+ character random credential; never reuse EMBEDDING_SECRET.
EXECUTION_INTERNAL_SECRET=
OPENAI_API_KEY=
# Explicit opt-in, supported fixed snapshot: gpt-5.4-mini-2026-03-17
EXECUTION_MODEL=
EXECUTION_MAX_OUTPUT_TOKENS=800
EXECUTION_PROVIDER_TIMEOUT_SECONDS=30
